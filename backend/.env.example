# I-copy ito bilang backend/.env (hindi ito naka-commit sa git)
# Lahat dito ay opsyonal — may default values sa config.php

# Database (XAMPP default: root, walang password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hr_management
DB_USER=root
DB_PASS=

# JWT secret — PALITAN bago i-deploy!
JWT_SECRET=palitan-ito-ng-random-string-bago-i-deploy

# Geofence ng office (GPS coordinates + radius sa meters)
COMPANY_LAT=14.5995
COMPANY_LNG=120.9842
GEOFENCE_RADIUS_M=100
# Kung true: REJECTED ang clock-in outside geofence
REQUIRE_GEOFENCE=false

# Work start time (late policy)
WORK_START_H=8
WORK_START_M=0

# WebSocket server (Node.js)
WS_NOTIFY_URL=http://127.0.0.1:8081

# Google Sheets live data (published-to-web CSV URL)
SHEET_CSV_URL=

# CORS origins (comma-separated) — idagdag ang Netlify URL dito
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-site.netlify.app
