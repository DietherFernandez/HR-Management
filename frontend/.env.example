# Sa Netlify, ito ay environment variable:
#   Site settings → Environment variables → VITE_API_URL
# Halimbawa: VITE_API_URL=https://your-xampp-server.com/api
# Kung wala, default ay /api (same-origin — kapag naka-proxy o naka-subfolder)
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8081
